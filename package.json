{
  "name": "agent-context-viewer",
  "version": "0.2.0",
  "private": true,
  "description": "TUI that shows how AI coding agents assemble context — system prompts, AGENTS.md files, per-turn context before/after, and full transcripts.",
  "license": "MIT",
  "bin": {
    "acv": "src/main.tsx"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "module": "src/main.tsx",
  "scripts": {
    "start": "bun run src/main.tsx",
    "build:release": "bun run scripts/build-release.ts",
    "dev": "bun --watch run src/main.tsx",
    "typecheck": "tsc --noEmit",
    "verify:ui": "bun run scripts/verify-ui.ts",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "lint": "biome check src",
    "extract-tool-snippets": "bun run scripts/extract-tool-snippets.ts",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "verify:integrations": "bun run scripts/verify-integrations.ts",
    "verify:codex": "bun run scripts/verify-codex-fixture.ts",
    "verify:release": "bun run scripts/verify-release.ts"
  },
  "dependencies": {
    "@ff-labs/fff-bun": "^0.11.0",
    "@opentui/core": "^0.5.17",
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@effect/language-service": "^0.87.4",
    "@effect/tsgo": "0.36.4",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "aube": {
    "supportedArchitectures": {
      "os": [
        "linux"
      ],
      "cpu": [
        "x64",
        "arm64"
      ],
      "libc": [
        "glibc"
      ]
    }
  }
}
